{
  "name": "freebuff2api-proxy",
  "version": "1.0.0",
  "description": "High-performance, dual-runtime OpenAI-compatible API router and OAuth proxy for Freebuff unmetered AI access",
  "main": "dist/cli.js",
  "bin": {
    "freebuff2api": "dist/cli.js",
    "freebuff2api-proxy": "dist/cli.js"
  },
  "files": [
    "dist",
    "worker.js",
    "public",
    "README.md",
    "LICENSE",
    "wrangler.toml"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx src/cli/index.ts serve --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "keywords": [
    "freebuff",
    "codebuff",
    "openai",
    "proxy",
    "router",
    "reverse-proxy",
    "cloudflare-workers",
    "deepseek",
    "hono",
    "agent",
    "ai-gateway"
  ],
  "homepage": "https://github.com/IMROVOID/Freebuff2API#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMROVOID/Freebuff2API.git"
  },
  "bugs": {
    "url": "https://github.com/IMROVOID/Freebuff2API/issues"
  },
  "author": "IMROVOID",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "commander": "^13.1.0",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^3.0.8",
    "wrangler": "^3.111.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
